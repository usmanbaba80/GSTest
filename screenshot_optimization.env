# =====================================================================
# SCREENSHOT API OPTIMIZATION SETTINGS
# Add these to your .env file to customize screenshot performance
# =====================================================================

# Screenshot Request Management
SCREENSHOT_MAX_CONCURRENT=50              # Max parallel screenshots (adjust based on server CPU/RAM)
SCREENSHOT_ENABLE_QUEUING=True            # Enable intelligent queuing (recommended: True)
SCREENSHOT_QUEUE_SIZE=200                 # Queue capacity (reduce if memory constrained)  
SCREENSHOT_QUEUE_TIMEOUT=60               # Max wait time in queue (seconds)
SCREENSHOT_RETRY_ATTEMPTS=2               # Retry attempts for failed screenshots
SCREENSHOT_TIMEOUT_REDUCED=15             # Fast timeout for first attempt (seconds)
SCREENSHOT_ENABLE_REQUEST_METRICS=True    # Enable detailed metrics (recommended: True)

# Browser Pool Optimization  
BROWSER_POOL_SIZE_OPTIMIZED=8             # Number of browser instances (8 = good balance)
MAX_TABS_PER_BROWSER_OPTIMIZED=6          # Tabs per browser (6 = optimal resource usage)
BROWSER_LAUNCH_CONCURRENT=3               # Browsers that can launch simultaneously
BROWSER_HEALTH_CHECK_INTERVAL=30          # Health check frequency (seconds)

# =====================================================================
# RECOMMENDED ADJUSTMENTS TO EXISTING SEARCH API SETTINGS
# Update these if you previously set them too high
# =====================================================================

# Database Pool (Reduced for Stability)
DB_POOL_SIZE=30                           # Reduced from 150 to prevent MySQL max_connections issues

# Search API (Balanced Performance)  
SEARCH_MAX_CONCURRENT=100                 # Reduced from 200 for stability
SEARCH_QUEUE_SIZE=500                     # Reduced from 1000 for memory efficiency
SEARCH_QUEUE_TIMEOUT=60                   # Reduced from 120 for faster feedback
SEARCH_CACHE_TIMEOUT=2                    # Reduced from 3 for faster cache checks
SEARCH_RETRY_ATTEMPTS=1                   # Reduced from 3 for faster failure feedback

# HTTP Client Pool (Optimized)
HTTP_MAX_CONNECTIONS=100                  # Reduced from 200
HTTP_MAX_KEEPALIVE=25                     # Reduced from 50  
HTTP_KEEPALIVE_EXPIRY=20                  # Reduced from 30
HTTP_CONNECT_TIMEOUT=10                   # Reduced from 15
HTTP_READ_TIMEOUT=30                      # Reduced from 60
HTTP_WRITE_TIMEOUT=5                      # Reduced from 10
HTTP_POOL_TIMEOUT=2                       # Reduced from 5

# Performance Tuning
SEARCH_ENABLE_BACKGROUND_CACHING=False    # Disabled to reduce DB load
SEARCH_CACHE_INSERTION_TIMEOUT=5          # Reduced from 15 