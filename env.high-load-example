# High-Load Configuration for 1500+ Concurrent Screenshot Requests
# Copy this file to .env and update with your actual credentials

# Database Configuration (High-Load Optimized)
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=your_database_name
DB_POOL_SIZE=32                  # Increased from 32 for high concurrency
DB_SSL_CA=DigiCertGlobalRootCA.crt 1.pem

# AWS/S3 Configuration (Contabo)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_ENDPOINT_URL=https://usc1.contabostorage.com
S3_BUCKET_NAME=gsdatasync

# Proxy Configuration
PROXY_URL=http://your_proxy_url

# Application Configuration
BASE_PATH=https://usc1.contabostorage.com/gsdatasync/
LOG_LEVEL=WARNING                   # Reduced logging for performance

# High-Load Browser Configuration
BROWSER_POOL_SIZE=50                # Increased from 5 - supports 1500 tabs
MAX_TABS_PER_BROWSER=30             # Increased from 10 - 50 × 30 = 1500 capacity
SCREENSHOT_TIMEOUT=30               # Reduced timeout for faster processing
BROWSER_HEADLESS=true               # Always use headless for performance
MAX_CONCURRENT_SCREENSHOTS=500      # Rate limiting to prevent resource exhaustion
BROWSER_LAUNCH_TIMEOUT=30           # Faster browser startup timeout
PAGE_NAVIGATION_TIMEOUT=15          # Faster page load timeout

# High-Load Performance Notes:
# - Total browser capacity: 50 browsers × 30 tabs = 1,500 concurrent tabs
# - Rate limiting at 500 concurrent requests prevents memory exhaustion
# - Remaining 1,000 requests receive HTTP 429 (retry later)
# - Estimated memory usage: ~100GB total system memory required
# - Recommended hardware: 32+ CPU cores, 128GB RAM, SSD storage

# System Requirements for This Configuration:
# - CPU: 32+ cores (Intel Xeon/AMD EPYC recommended)
# - RAM: 128GB+ (64GB minimum)
# - Storage: 1TB+ SSD
# - Network: 10Gbps+ for optimal performance
# - OS: Linux (Ubuntu 20.04+) or Windows Server

# Expected Performance:
# - Cold start: 50-100 requests/minute
# - Warm state: 500-800 requests/minute  
# - Peak performance: 1,000+ requests/minute
# - Average response time: 8-12 seconds under load 